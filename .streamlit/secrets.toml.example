# Modelo dos segredos do app no Streamlit Community Cloud.
# Cole o conteudo em "Settings > Secrets" do app e preencha as chaves.
# Cada linha vira variavel de ambiente, lida pelo app como as do .env.
# Para testar localmente, copie para ".streamlit/secrets.toml" (nunca vai para o git).

# So o projeto ficticio do repositorio. A massa do hackathon e confidencial e
# nao pode ir para um app publico.
LEI_DO_BEM_PACOTE = "dados/fixtures/pacote_exemplo"

# Pelo menos uma chave. Com as tres, cada provedor assume um papel e os outros
# ficam de reserva quando a cota gratuita acaba.
GEMINI_API_KEY = ""
GROQ_API_KEY = ""
OPENROUTER_API_KEY = ""

GEMINI_MODEL = "gemini-3.8-flash,gemini-3.6-flash"
GROQ_MODEL = "openai/gpt-oss-120b,openai/gpt-oss-20b"
OPENROUTER_MODEL = "nvidia/nemotron-3-super-120b-a12b:free"
