# Copie este arquivo para ".env" e preencha. O ".env" nunca vai para o git.

# Chave do OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Modelo usado pelo motor. Em branco, usa o gratuito padrao do projeto.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Esforco de raciocinio do modelo: low, medium ou high. Em branco, vale o padrao
# do modelo. "low" responde bem mais rapido; confira a qualidade com a calibracao.
OPENROUTER_RACIOCINIO=

# Pasta onde o pacote do hackathon foi extraido (a que contem "01_projetos").
# A massa e confidencial: mantenha fora do repositorio.
LEI_DO_BEM_PACOTE=

# Orquestracao: cada provedor assume um papel. Com as tres chaves, o Gemini
# avalia os criterios, o Groq confronta entrevista e registros e o OpenRouter
# audita as fontes. Faltando uma chave, os papeis sao redistribuidos.
# Chave do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Chave do Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Pasta das analises, dos logs de decisao e dos dossies. Em branco, vale "saida/".
LEI_DO_BEM_SAIDA=
